# Port the service listens on
PORT=3000

# GoHighLevel inbound webhook URL (Automation > Workflows > Trigger: Inbound Webhook).
# Keep the real URL secret. Never commit it.
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/YOUR_LOCATION_ID/webhook-trigger/YOUR_TRIGGER_ID

# Shared secret. Add ?token=<value> to the webhook URL you paste into Elementor.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Optional: map unlabeled Elementor fields to clean names (JSON).
# Elementor sends unlabeled fields as "No label field <id>" when Advanced Data is off.
FIELD_MAP={"No label field abc1234":"wants_short_call"}

# Optional: comma-separated fields that should be sent to GHL as "Yes"/"No".
BOOLEAN_FIELDS=wants_short_call

# Forwarding behaviour
FORWARD_TIMEOUT_MS=8000
FORWARD_MAX_RETRIES=3
